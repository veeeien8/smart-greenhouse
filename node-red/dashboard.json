    "type": "http request",
    "name": "Leaf server catalog (port 8000)",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://127.0.0.1:8000/api/leaves",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "requestTimeout": "5000"
  },
  {
    "id": "sgas-catalog-parse",
    "type": "function",
    "z": "sgas-flow",
    "name": "Validate leaf catalog",
    "func": "if (msg.error || msg.statusCode !== 200 || !Array.isArray(msg.payload) ||\n !msg.payload.every(l => l && /^[a-f0-9]{16}$/.test(l.id) && typeof l.name === \"string\")) {\n return {kind:\"leaves\",payload:[],leafError:\"Leaf server unavailable. Run python leaf_server.py, then Refresh leaves.\"};\n}\nreturn {kind:\"leaves\",payload:msg.payload};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
    "y": 380,
    "wires": [
