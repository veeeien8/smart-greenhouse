  {
    "id": "sgas-command",
    "type": "function",
    "z": "sgas-flow",
    "name": "Classify selected leaf / refresh",
    "func": "if (msg.action === \"refresh\") return [null, {}];\nconst leaves = flow.get(\"sgasLeaves\") || [];\nif (msg.action !== \"classify\" || !/^[a-f0-9]{16}$/.test(msg.leafId || \"\") ||\n    !leaves.some(leaf => leaf.id === msg.leafId)) return null;\nreturn [{payload:\"CLASSIFY:\" + msg.leafId, topic:\"sgas/vietanh/command\", qos:\"0\", retain:false}, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 260,
    "wires": [
      [
        "sgas-out"
      ],
      [
        "sgas-catalog-http"
      ]
    ]
  },
