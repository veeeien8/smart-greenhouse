  {
    "id": "sgas-result-parse",
    "type": "function",
    "z": "sgas-flow",
    "name": "Validate prediction",
    "func": "let p=msg.payload;\ntry { if (typeof p === \"string\") p=JSON.parse(p); } catch(e) { return null; }\nif (!p || !/^[a-f0-9]{16}$/.test(p.leafId || \"\") || ![\"running\",\"done\",\"error\"].includes(p.status)) return null;\nif (p.status === \"done\" && (![\"HEALTHY\",\"DISEASED\"].includes(p.prediction) ||\n    typeof p.probability !== \"number\" || !Number.isFinite(p.probability) || p.probability < 0 || p.probability > 1)) return null;\nif (p.status === \"error\" && typeof p.error !== \"string\") return null;\nreturn {kind:\"result\",payload:p};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
