  {
    "id": "sgas-state",
    "type": "function",
    "z": "sgas-flow",
    "name": "Combine dashboard state",
    "func": "const state = context.get(\"state\") || {payload:{}, receivedAt:0, leaves:[], leafError:\"\", result:null};\nif (msg.kind === \"telemetry\") { state.payload=msg.payload; state.receivedAt=msg.receivedAt; }\nelse if (msg.kind === \"leaves\") {\n  state.leaves=msg.payload; state.leafError=msg.leafError || \"\";\n  flow.set(\"sgasLeaves\", state.leaves);\n} else if (msg.kind === \"result\") { state.result={...msg.payload, receivedAt:Date.now()}; }\nelse return null;\ncontext.set(\"state\", state);\nreturn {...state};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 160,
    "wires": [
