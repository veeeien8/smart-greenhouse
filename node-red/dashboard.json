  {
    "id": "sgas-parse",
    "type": "function",
    "z": "sgas-flow",
    "name": "Validate and timestamp",
    "func": "let p = msg.payload;\ntry { if (typeof p === \"string\") p = JSON.parse(p); } catch (e) { node.warn(\"Invalid telemetry JSON\"); return null; }\nif (!p || typeof p !== \"object\" || Array.isArray(p)) return null;\nif (![\"NORMAL\",\"HOT\",\"COLD\",\"HUMID\",\"DRY\",\"LOW LIGHT\",\"ALERT\"].includes(p.state)) return null;\nfor (const key of [\"vent\",\"heater\",\"humidifier\",\"growLight\",\"alert\"]) {\n  if (typeof p[key] !== \"boolean\") return null;\n}\nfor (const key of [\"temperature\",\"humidity\"]) {\n  if (p[key] !== null && (typeof p[key] !== \"number\" || !Number.isFinite(p[key]))) return null;\n}\nif (typeof p.light !== \"number\" || !Number.isFinite(p.light) || p.light < 0 || p.light > 4095) return null;\nif (p.alert) p = {...p, temperature:null, humidity:null};\nreturn {kind:'telemetry', payload:p, receivedAt:Date.now()};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 160,
    "wires": [
      [
        "sgas-state"
      ]
    ]
  },
  {
    "id": "sgas-ui",
    "type": "ui-template",
    "z": "sgas-flow",
    "group": "sgas-group",
    "page": "",
    "ui": "",
    "name": "Greenhouse dashboard",
    "order": 1,
    "width": "12",
    "height": "0",
    "head": "",
    "format": "<template>\n<section class=\"sgas\">\n  <header><div><small>3707ICT · SMART GREENHOUSE</small><h1>Greenhouse overview</h1></div><span :class=\"['sgas-pill', fresh ? 'sgas-good' : 'sgas-warn']\">{{ fresh ? 'Receiving telemetry' : (received ? 'Telemetry stale' : 'Waiting for telemetry') }}</span></header>\n  <p class=\"sgas-muted\">Last received: {{ received ? new Date(received).toLocaleString() : '—' }} · Automatic control</p>\n  <div class=\"sgas-grid\">\n    <article v-for=\"s in sensors\" :key=\"s.key\" class=\"sgas-card\">\n      <h3>{{ s.label }}</h3><div class=\"sgas-value\">{{ reading(s.key) }} <small>{{ s.unit }}</small></div>\n      <progress :value=\"level(s)\" max=\"100\" :aria-label=\"s.label\"></progress>\n      <p>{{ s.note }}</p>\n    </article>\n  </div>\n  <div class=\"sgas-grid sgas-bottom\">\n    <article class=\"sgas-card\"><h3>System status</h3><h2>{{ payload.state || 'Waiting' }}</h2><p :class=\"payload.alert ? 'sgas-danger' : ''\">{{ payload.alert === true ? 'DHT22 sensor fault — temperature and humidity unavailable' : payload.alert === false ? 'No sensor fault reported' : 'Waiting for sensor status' }}</p><p v-if=\"received && !fresh\" class=\"sgas-danger\">Readings and actuator states below are the last known values.</p></article>\n    <article class=\"sgas-card\"><h3>Actuators</h3><div v-for=\"a in actuators\" :key=\"a.key\" class=\"sgas-row\"><span>{{ a.label }}</span><strong>{{ state(a.key, a.on, a.off) }}</strong></div></article>\n    <article class=\"sgas-card\"><h3>Plant health</h3>\n      <label for=\"sgas-leaf\">Choose a local leaf ({{ leaves.length }} available)</label>\n      <select id=\"sgas-leaf\" v-model=\"selectedLeaf\" :disabled=\"busy\" class=\"sgas-select\">\n        <option disabled value=\"\">Select a leaf</option>\n        <option v-for=\"leaf in leaves\" :key=\"leaf.id\" :value=\"leaf.id\">{{ leaf.name }}</option>\n      </select>\n      <p v-if=\"leafError\" class=\"sgas-danger\">{{ leafError }}</p>\n      <div class=\"sgas-actions\"><v-btn variant=\"outlined\" :disabled=\"busy\" @click=\"send({action:'refresh'})\">Refresh leaves</v-btn>\n      <v-btn color=\"primary\" :disabled=\"!fresh || !selectedLeaf || busy\" @click=\"classify\">Classify leaf</v-btn></div>\n      <p v-if=\"busy\">Waiting for the ESP32 prediction…</p>\n      <p v-if=\"timedOut\" class=\"sgas-danger\">No result received within 90 seconds. Check the leaf server and Wokwi Serial Monitor, then retry.</p>\n      <div v-if=\"result\" class=\"sgas-result\" aria-live=\"polite\">\n        <strong>{{ result.status === 'done' ? result.prediction : result.status === 'running' ? 'Classifying…' : 'Classification failed' }}</strong>\n        <p v-if=\"result.status === 'done'\">Disease probability: {{ (result.probability * 100).toFixed(1) }}%</p>\n        <p v-if=\"result.error\" class=\"sgas-danger\">{{ result.error }}</p>\n        <small>{{ resultName }} · {{ new Date(result.receivedAt).toLocaleTimeString() }}</small>\n      </div>\n      <small>Run leaf_server.py to serve existing BMPs. The ESP32 model classifies the selected leaf.</small>\n    </article>\n  </div>\n</section>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      now: Date.now(), timer: null, selectedLeaf: '', requestedAt: 0, requestedLeaf: '',\n      sensors: [\n        {key:'temperature',label:'Temperature',unit:'°C',min:-40,max:80,note:'Cold below 18°C · Hot above 30°C'},\n        {key:'humidity',label:'Humidity',unit:'%',min:0,max:100,note:'Dry below 40% · Humid above 80%'},\n        {key:'light',label:'Light sensor',unit:'ADC',min:0,max:4095,note:'Higher means darker · Low light above 2500'}\n      ],\n      actuators: [\n        {key:'vent',label:'Ventilation',on:'OPEN',off:'CLOSED'},\n        {key:'heater',label:'Heater',on:'ON',off:'OFF'},\n        {key:'humidifier',label:'Humidifier',on:'ON',off:'OFF'},\n        {key:'growLight',label:'Grow light',on:'ON',off:'OFF'}\n      ]\n    }\n  },\n  computed: {\n    payload() { return this.msg?.payload || {} },\n    received() { return this.msg?.receivedAt || 0 },\n    fresh() { return this.received > 0 && this.now - this.received < 15000 },\n    leaves() { return this.msg?.leaves || [] },\n    leafError() { return this.msg?.leafError || '' },\n    result() { return this.msg?.result || null },\n    resultName() { return this.leaves.find(l => l.id === this.result?.leafId)?.name || this.result?.leafId || 'Selected leaf' },\n    completed() { return this.result && this.result.leafId === this.requestedLeaf && this.result.receivedAt >= this.requestedAt && ['done','error'].includes(this.result.status) },\n    busy() { return this.requestedAt > 0 && !this.completed && this.now - this.requestedAt < 90000 },\n    timedOut() { return this.requestedAt > 0 && !this.completed && this.now - this.requestedAt >= 90000 }\n  },\n  watch: {\n    leaves(list) { if (!list.some(l => l.id === this.selectedLeaf)) this.selectedLeaf = '' }\n  },\n  methods: {\n    reading(key) {\n      const v = this.payload[key];\n      return typeof v === 'number' && Number.isFinite(v) ? (key === 'light' ? v : v.toFixed(1)) : '—';\n    },\n    level(s) {\n      const v = this.payload[s.key];\n      return typeof v === 'number' && Number.isFinite(v) ? Math.max(0, Math.min(100, (v-s.min)/(s.max-s.min)*100)) : 0;\n    },\n    state(key, on, off) { return this.payload[key] === true ? on : this.payload[key] === false ? off : '—' },\n    classify() {\n      this.requestedAt = Date.now();\n      this.requestedLeaf = this.selectedLeaf;\n      this.now = this.requestedAt;\n      this.send({action:'classify', leafId:this.selectedLeaf});\n    }\n  },\n  mounted() { this.timer = setInterval(() => { this.now = Date.now() }, 1000); this.send({action:'refresh'}) },\n  unmounted() { clearInterval(this.timer) }\n}\n</script>\n<style>\n.sgas {padding:20px;color:#183b30;background:#f4f8f5;border-radius:16px}\n.sgas header {display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}\n.sgas h1 {font-size:28px;margin:4px 0}.sgas h2{margin:12px 0}.sgas h3{font-size:15px;margin:0 0 16px}\n.sgas small,.sgas-muted{color:#567165}.sgas p{font-size:14px;margin:12px 0}\n.sgas-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:20px}\n.sgas-card{background:white;border:1px solid #dce8df;border-radius:12px;padding:20px}\n.sgas-value{font-size:38px;font-weight:700}.sgas-value small{font-size:18px}\n.sgas progress{width:100%;height:10px;accent-color:#24835b;margin-top:16px}\n.sgas-pill{border-radius:20px;padding:8px 14px;font-size:13px;font-weight:600}\n.sgas-good{background:#d9f0e2;color:#165d36}.sgas-warn{background:#fff0cd;color:#785300}\n.sgas-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #eef3ef}\n.sgas-select{width:100%;padding:10px;border:1px solid #9fbaaa;border-radius:6px;margin:8px 0 12px;background:white}\n.sgas-actions{display:flex;flex-wrap:wrap;gap:8px}.sgas-result{margin:16px 0;padding:12px;background:#f1f7f2;border-radius:8px;overflow-wrap:anywhere}\n.sgas .sgas-danger{color:#b3261e}\n@media(max-width:850px){.sgas-grid{grid-template-columns:1fr}.sgas{padding:12px}}\n</style>",
    "storeOutMessages": false,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 900,
    "y": 160,
    "wires": [
      [
        "sgas-command"
      ]
    ]
